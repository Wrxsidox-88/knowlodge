# 服务端口
PORT=8787

# 鉴权密钥（生产环境请修改）
AUTH_SECRET=knowlodge-dev-secret

# OpenAI 兼容 API 配置（也可在 Web 前端"设置"页运行时修改）
# 示例：
#   OpenAI    : https://api.openai.com/v1        gpt-4o-mini / text-embedding-3-small
#   DeepSeek  : https://api.deepseek.com/v1      deepseek-chat / (无 embedding 时可留空)
#   通义千问  : https://dashscope.aliyuncs.com/compatible-mode/v1  qwen-plus / text-embedding-v3
AI_BASE_URL=
AI_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
# 备用对话模型（主模型失败时自动切换，多模型轮询/备用）
AI_CHAT_MODEL_BACKUP=
# 每个模型的请求重试次数
AI_RETRY_COUNT=1
AI_EMBED_MODEL=text-embedding-3-small
# 视觉分析模型（分析材料中的图像：docx/pdf 内嵌图片、图片材料、扫描页渲染）
# 示例：gpt-4o-mini / qwen-vl-plus / deepseek 暂无视觉能力可留空
AI_VISION_MODEL=
# 错题录入后自动 AI 分析（on/off）
STUDY_AUTO_ANALYZE=on
# 允许 AI 分析时按需创建知识清单（on/off）
LISTS_AI_AUTOCREATE=off
# 允许 AI 直接修改现有子知识网（on/off）
# on ：分析前注入已有知识图谱，由 AI 判断"并入已有子网"还是"新建子网"
# off：不注入已有图谱，每次分析都为材料新建独立子网，不改动已有子网
AI_MODIFY_SUBGRAPHS=on
